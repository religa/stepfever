{
	"buildCommand": "bun run build",
	"outputDirectory": "packages/web/dist",
	"installCommand": "bun install",
	"rewrites": [{ "source": "/(.*)", "destination": "/" }],
	"headers": [
		{
			"source": "/assets/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
		}
	]
}
