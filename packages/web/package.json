{
	"name": "@stepfever/web",
	"version": "0.1.0",
	"description": "Web client for StepFever rhythm game - PixiJS renderer, Tone.js audio, and game UI",
	"author": "step.fever.team",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/religa/stepfever.git",
		"directory": "packages/web"
	},
	"keywords": ["rhythm-game", "pixijs", "tonejs", "browser-game", "webgl"],
	"type": "module",
	"scripts": {
		"prebuild": "bun scripts/generate-songs.ts",
		"dev": "bun run prebuild && vite",
		"build": "bun run prebuild && tsc && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@stepfever/core": "workspace:*",
		"pixi.js": "^8.0.0",
		"tone": "^15.0.0",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@vitest/ui": "^3.0.0",
		"happy-dom": "^15.0.0",
		"vite": "^6.0.0",
		"vite-plugin-static-copy": "^3.1.6",
		"vitest": "^3.0.0"
	}
}
